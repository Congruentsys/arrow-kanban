# kanban.ttl — Core OWL Ontology for arrow-kanban
#
# Defines the class hierarchy and property vocabulary for all 13 arrow-kanban
# item types. This is the foundational ontology that SHACL shapes
# and the template system depend on.
#
# Namespace: kb: <https://congruentsys.org/ns/arrow-kanban/kanban/>
#
# Installation:
#   Built-in: compiled into arrow-kanban binary (shipped in crates/arrow-kanban/ontology/)
#   Project-local override: .arrow-kanban/kanban.ttl
#   User-global override:   ~/.config/arrow-kanban/kanban.ttl
#
# Override priority: project-local > user-global > built-in
#
# Usage by SHACL shapes:
#   sh:targetClass kb:Expedition (requires this ontology to be loaded first)
#
# V12/V13 parity: none — arrow-kanban had no formal OWL ontology. This is new.
# V14 capability: all 13 item types queryable as typed graph nodes via SPARQL.

@prefix kb:   <https://congruentsys.org/ns/arrow-kanban/kanban/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ---------------------------------------------------------------------------
# Ontology declaration
# ---------------------------------------------------------------------------

<https://congruentsys.org/ns/arrow-kanban/kanban/> a owl:Ontology ;
    rdfs:label "arrow-kanban Core Ontology" ;
    rdfs:comment "OWL class hierarchy and property vocabulary for arrow-kanban item types." .

# ---------------------------------------------------------------------------
# Root item class
# ---------------------------------------------------------------------------

kb:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "Root class for all arrow-kanban items (dev board and research board)." .

# ---------------------------------------------------------------------------
# Board partition classes
# ---------------------------------------------------------------------------

kb:DevItem a owl:Class ;
    rdfs:subClassOf kb:Item ;
    rdfs:label "Dev Board Item" ;
    rdfs:comment "Items on the development board: Expedition, Voyage, Campaign, Chore, Hazard, Signal, Feature." .

kb:ResearchItem a owl:Class ;
    rdfs:subClassOf kb:Item ;
    rdfs:label "Research Board Item" ;
    rdfs:comment "Items on the research board: Paper, Hypothesis, Experiment, Measure, Idea, Literature." .

# ---------------------------------------------------------------------------
# Dev board item types (7)
# ---------------------------------------------------------------------------

kb:Expedition a owl:Class ;
    rdfs:subClassOf kb:DevItem ;
    rdfs:label "Expedition" ;
    rdfs:comment "Multi-step feature, architecture work, or algorithm port. Requires phases, tests, and DoD." .

kb:Voyage a owl:Class ;
    rdfs:subClassOf kb:DevItem ;
    rdfs:label "Voyage" ;
    rdfs:comment "Campaign grouping 3+ related expeditions with a shared goal. Created before its expeditions." .

kb:Campaign a owl:Class ;
    rdfs:subClassOf kb:DevItem ;
    rdfs:label "Campaign" ;
    rdfs:comment "Program grouping 2+ related voyages under one narrative arc. Member voyages link via kb:partOf (opt-in graph structure, not a forced parent). The container above a voyage." .

kb:Chore a owl:Class ;
    rdfs:subClassOf kb:DevItem ;
    rdfs:label "Chore" ;
    rdfs:comment "Routine maintenance, tooling, cleanup, or infrastructure work." .

kb:Hazard a owl:Class ;
    rdfs:subClassOf kb:DevItem ;
    rdfs:label "Hazard" ;
    rdfs:comment "Risk or blocker that may impact planned work. Requires mitigation plan." .

kb:Signal a owl:Class ;
    rdfs:subClassOf kb:DevItem ;
    rdfs:label "Signal" ;
    rdfs:comment "Observation, anomaly, or data point captured immediately. No approval needed." .

kb:Feature a owl:Class ;
    rdfs:subClassOf kb:DevItem ;
    rdfs:label "Feature" ;
    rdfs:comment "User-facing capability with acceptance criteria." .

# ---------------------------------------------------------------------------
# Research board item types (6)
# ---------------------------------------------------------------------------

kb:Paper a owl:Class ;
    rdfs:subClassOf kb:ResearchItem ;
    rdfs:label "Paper" ;
    rdfs:comment "Research paper in progress or external paper being tracked." .

kb:Hypothesis a owl:Class ;
    rdfs:subClassOf kb:ResearchItem ;
    rdfs:label "Hypothesis" ;
    rdfs:comment "Testable claim about system behavior. Never complete — validated per experiment and version." .

kb:Experiment a owl:Class ;
    rdfs:subClassOf kb:ResearchItem ;
    rdfs:label "Experiment" ;
    rdfs:comment "Concrete test run (benchmark, A/B test, spike). One-shot and version-bound." .

kb:Measure a owl:Class ;
    rdfs:subClassOf kb:ResearchItem ;
    rdfs:label "Measure" ;
    rdfs:comment "Metric tracked across experiments and being versions. Stays active indefinitely." .

kb:Idea a owl:Class ;
    rdfs:subClassOf kb:ResearchItem ;
    rdfs:label "Idea" ;
    rdfs:comment "Capture for a potential hypothesis. Promoted to Hypothesis or abandoned." .

kb:Literature a owl:Class ;
    rdfs:subClassOf kb:ResearchItem ;
    rdfs:label "Literature" ;
    rdfs:comment "Survey of external papers for project relevance. Has a completion state." .

# ---------------------------------------------------------------------------
# Board and relation structural classes
# ---------------------------------------------------------------------------

kb:Board a owl:Class ;
    rdfs:label "Board" ;
    rdfs:comment "A arrow-kanban board (development or research)." .

kb:DevBoard a owl:Class ;
    rdfs:subClassOf kb:Board ;
    rdfs:label "Development Board" .

kb:ResearchBoard a owl:Class ;
    rdfs:subClassOf kb:Board ;
    rdfs:label "Research Board" .

kb:Relation a owl:Class ;
    rdfs:label "Relation" ;
    rdfs:comment "A directed relation between two items. Stored in the relations Arrow table." .

# ---------------------------------------------------------------------------
# Core item datatype properties
# (correspond to columns in the Arrow items RecordBatch schema)
# ---------------------------------------------------------------------------

kb:status a owl:DatatypeProperty ;
    rdfs:domain kb:Item ;
    rdfs:range xsd:string ;
    rdfs:label "status" ;
    rdfs:comment "Workflow state. Valid values are type-specific (see SHACL shapes)." .

kb:priority a owl:DatatypeProperty ;
    rdfs:domain kb:Item ;
    rdfs:range xsd:string ;
    rdfs:label "priority" ;
    rdfs:comment "Priority level: low | medium | high | critical." .

kb:assignee a owl:DatatypeProperty ;
    rdfs:domain kb:Item ;
    rdfs:range xsd:string ;
    rdfs:label "assignee" ;
    rdfs:comment "Agent responsible for this item: M5 | DGX | Mini | unassigned." .

kb:body a owl:DatatypeProperty ;
    rdfs:domain kb:Item ;
    rdfs:range xsd:string ;
    rdfs:label "body" ;
    rdfs:comment "Markdown body content (phases, context, DoD, turtle blocks, etc.)." .

kb:tags a owl:DatatypeProperty ;
    rdfs:domain kb:Item ;
    rdfs:range xsd:string ;
    rdfs:label "tags" ;
    rdfs:comment "Comma-separated tags for filtering (e.g. v14,rust,shacl)." .

# ---------------------------------------------------------------------------
# Relation object properties
# (correspond to predicate values in the Arrow relations RecordBatch)
#
# THIS SECTION IS THE RUNTIME EDGE VOCABULARY: arrow-kanban
# loads these owl:ObjectProperty declarations at startup and validates every
# `--relate` edge against them. rdfs:domain/rdfs:range are enforced
# (kb:Item = any item type); owl:inverseOf declares the derived inverse (only
# ONE direction of an edge is ever stored). Editing this block changes the
# live vocabulary — the loader is fail-closed, so a malformed edit falls back
# to the compiled-in strict set rather than silently opening the vocabulary.
# ---------------------------------------------------------------------------

kb:related a owl:ObjectProperty ;
    rdfs:domain kb:Item ;
    rdfs:range kb:Item ;
    rdfs:label "related" ;
    rdfs:comment "informational link between any two items (the existing --related)" .

kb:dependsOn a owl:ObjectProperty ;
    rdfs:domain kb:Item ;
    rdfs:range kb:Item ;
    owl:inverseOf kb:blocks ;
    rdfs:label "dependsOn" ;
    rdfs:comment "this item is BLOCKED BY the target (the existing --depends-on)" .

# Referenced by the SHACL shapes; previously only in the compiled const.
kb:blocks a owl:ObjectProperty ;
    rdfs:domain kb:Item ;
    rdfs:range kb:Item ;
    owl:inverseOf kb:dependsOn ;
    rdfs:label "blocks" ;
    rdfs:comment "this item BLOCKS the target (inverse of dependsOn; stored one way only)" .

# Referenced by the SHACL shapes; previously only in the compiled const.
kb:parent a owl:ObjectProperty ;
    rdfs:domain kb:Item ;
    rdfs:range kb:Item ;
    rdfs:label "parent" ;
    rdfs:comment "hierarchical containment — this item is contained by the target" .

# Campaign membership: a member item is part of a larger
# grouping node — the predicate the Campaign type and the rollup view
# traverse. Added by editing THIS FILE ONLY — no Rust vocabulary
# change — proving the open-graph property of the data-driven loader.
# Distinct from kb:parent (informal containment, no inverse): partOf/hasMember
# is the queryable membership pair. Domain/range are kb:Item (any→any) because
# membership crosses types (voyage→campaign today; research groupings later);
# deliberately NOT projected to a flat items column — no current consumer
# (roadmap/critical-path/worklist) reads it, and the campaign rollup reads the typed edges.
kb:partOf a owl:ObjectProperty ;
    rdfs:domain kb:Item ;
    rdfs:range kb:Item ;
    owl:inverseOf kb:hasMember ;
    rdfs:label "partOf" ;
    rdfs:comment "this item is a member of the target grouping (e.g. a voyage partOf a campaign); only ONE direction is stored" .

kb:hasMember a owl:ObjectProperty ;
    rdfs:domain kb:Item ;
    rdfs:range kb:Item ;
    owl:inverseOf kb:partOf ;
    rdfs:label "hasMember" ;
    rdfs:comment "the target is a member of this grouping (derived inverse of partOf; stored one way only)" .

# ── proposals join the graph ────────────────────────────────────────────────
# A proposal's link to the work item it closes was, until now, recoverable only by
# MATCHING TEXT against the proposal's prose. That cannot work when a project cites
# item ids in prose deliberately (many do — a citation convention is good practice):
# every such matcher confuses a CITATION for the subject. Measured on a live board,
# two proposals in a row were reported as closing an item they merely CITED rather
# than the one they closed — and the sweep that consumes this ends its instruction
# with "+ close", so a misread closes the wrong item.
#
# Domain/range are kb:Item (= ANY) rather than a Proposal class, DELIBERATELY: the
# guard `every_ttl_domain_and_range_names_a_real_item_type` requires every constraint
# to name a registered ItemType, and Proposal is not one — it has its own namespace,
# lifecycle and store. Admitting proposals as a graph entity class is what TIGHTENS
# these two to Proposal→Item. Until then this is an honest any→any edge, and the
# relations table already accepts a PROP- source_id (source_id/target_id are plain
# Utf8, schema.rs:113-126) — so this needs no schema change.

# ---------------------------------------------------------------------------
# Graph-admitted ENTITY CLASSES beyond the board.
#
# THE RULING (recorded where it binds): Proposal — and Comment,
# Run, ExperimentRun, CiResult — are DISTINCT KINDS, not ItemTypes. Evidence:
# each has its own store and schema (ProposalStore; comments/runs schemas), its
# own id namespace (a `PROP-` / `CMT-` prefix), and either a DIFFERENT lifecycle
# (proposal: open/approved/merged/closed — not board statuses) or NONE (a
# comment has no lifecycle at all). Admitting them as ItemTypes would put them
# on board surfaces (list/move/boards) that deliberately exclude them. ItemType
# remains exactly "kinds that live on boards"; EntityClass is "kinds the GRAPH
# knows". Class-addition is DATA-DRIVEN like predicates: declare the class here
# (`kb:idPrefix` makes its ids prefix-resolvable); no Rust edit per class.
# ---------------------------------------------------------------------------

kb:idPrefix a owl:AnnotationProperty ;
    rdfs:label "idPrefix" ;
    rdfs:comment "UPPERCASE id prefix for ids of this class (e.g. PROP), letting the edge validator type an id the item store cannot resolve. Optional: a class with no prefix is a legal domain/range citizen whose ids simply cannot be prefix-typed." .

kb:Proposal a owl:Class ;
    kb:idPrefix "PROP" ;
    rdfs:label "Proposal" ;
    rdfs:comment "A graph-native code-review proposal (PROP-2000+; ProposalStore). Distinct kind, NOT a board ItemType: its lifecycle is open/approved/merged/closed. A first-class relation SUBJECT and TARGET: arrow-kanban update PROP-X --relate writes the forward spelling (relate-only — item fields refuse, since the record lives in the ProposalStore)." .

kb:Comment a owl:Class ;
    kb:idPrefix "CMT" ;
    rdfs:label "Comment" ;
    rdfs:comment "An item comment (CMT-*). Statement-shaped: no lifecycle. Admitted so comment->subject can be a typed edge instead of an implicit foreign key (EX-7101 Phase 4)." .

kb:Run a owl:Class ;
    rdfs:label "Run" ;
    rdfs:comment "A status-history transition record (runs schema). No public id prefix today; admitted for domain/range use by kb:transitions." .

kb:ExperimentRun a owl:Class ;
    rdfs:label "ExperimentRun" ;
    rdfs:comment "An experiment execution record (experiment_runs schema)." .

kb:CiResult a owl:Class ;
    rdfs:label "CiResult" ;
    rdfs:comment "A CI/check result attached to a proposal (CiResultStore)." .

# FK-relationship vocabulary, typed. ADD is data-only;
# USE (producers materializing these edges) is separate ordinary work, filed as
# its own item — the measured ADD/USE split (0 production Rust to add,
# normal Rust to wire).
kb:commentOn a owl:ObjectProperty ;
    rdfs:domain kb:Comment ;
    rdfs:range kb:Item ;
    rdfs:label "commentOn" ;
    rdfs:comment "this comment is on the target item (today an implicit FK column; typed so graph consumers can stop grepping). Producer: follow-on item." .

kb:transitions a owl:ObjectProperty ;
    rdfs:domain kb:Run ;
    rdfs:range kb:Item ;
    rdfs:label "transitions" ;
    rdfs:comment "this run record transitions the target item (status history FK, typed). Producer: follow-on item." .

kb:evaluates a owl:ObjectProperty ;
    rdfs:domain kb:CiResult ;
    rdfs:range kb:Proposal ;
    rdfs:label "evaluates" ;
    rdfs:comment "this CI result evaluates the target proposal (FK, typed). Producer: follow-on item." .

kb:closes a owl:ObjectProperty ;
    rdfs:domain kb:Proposal ;
    rdfs:range kb:Item ;
    owl:inverseOf kb:closedBy ;
    rdfs:label "closes" ;
    rdfs:comment "this proposal closes the target work item; recorded as an EDGE so no tool has to recover it by matching text (EX-7098). Only ONE direction is stored" .

kb:closedBy a owl:ObjectProperty ;
    rdfs:domain kb:Item ;
    rdfs:range kb:Proposal ;
    owl:inverseOf kb:closes ;
    rdfs:label "closedBy" ;
    rdfs:comment "the target proposal closes this item (derived inverse of closes; stored one way only)" .

# The supersession pair. Same any→any posture (and the same entity-class caveat)
# as closes/closedBy directly above: the motivating case is PROP-supersedes-PROP, and
# a Proposal is not yet a registered ItemType. Producers: `arrow-kanban move …
# --resolution superseded --superseded-by <ID>` and `arrow-kanban pr close … --superseded-by`
# (both write the supersededBy direction; one direction stored, the inverse derived).
kb:supersedes a owl:ObjectProperty ;
    rdfs:domain kb:Item ;
    rdfs:range kb:Item ;
    owl:inverseOf kb:supersededBy ;
    rdfs:label "supersedes" ;
    rdfs:comment "this item/proposal REPLACES the target; the live one in a duplicate pair. Stored one way only (the producer writes supersededBy)" .

kb:supersededBy a owl:ObjectProperty ;
    rdfs:domain kb:Item ;
    rdfs:range kb:Item ;
    owl:inverseOf kb:supersedes ;
    rdfs:label "supersededBy" ;
    rdfs:comment "this item/proposal was REPLACED by the target (CH-7173: --resolution superseded requires naming it, so 'what replaced this?' is an edge, never prose)" .

# ── DECISION / OBLIGATION EDGES (the remainder + ruling pairs) ───────────────────────
# Same root cause as `closes` above and `supersedes` below: a relationship existed
# conceptually but was stored as PROSE, so something had to grep for it — and the grep
# could not tell a SUBJECT from a CITATION, while a citation convention REQUIRES
# citing ids in prose.
#
# THE DISCRIMINATOR, generalised: does the fact SURVIVE the lifecycle?
#   survives -> EDGE (a ruling is true forever; a remainder outlives its PROP)
#   dies with the interaction -> FIELD (a review CLAIM is transient — deliberately NOT
#   modelled here; a separate concern owns it, and an edge would accumulate garbage)
#
# Domain/range are kb:Item (= ANY) for the same reason `closes` and `supersedes` are, not
# by oversight: `every_ttl_domain_and_range_names_a_real_item_type` requires a registered
# ItemType and Proposal is not one. Admitting proposals tightens these when it is.

kb:leavesRemainder a owl:ObjectProperty ;
    rdfs:domain kb:Item ;
    rdfs:range kb:Item ;
    owl:inverseOf kb:remainderOf ;
    rdfs:label "leavesRemainder" ;
    rdfs:comment "this proposal is a PARTIAL pass and the target item carries its outstanding scope. Seeded by the server from the `completes-item:` line at pr.create/pr.edit — so a SEEDED edge is a scraped guess, not an assertion; a human's `remainderOf` (the only direction `arrow-kanban update` accepts) is the asserted one. Only ONE direction is stored" .

kb:remainderOf a owl:ObjectProperty ;
    rdfs:domain kb:Item ;
    rdfs:range kb:Item ;
    owl:inverseOf kb:leavesRemainder ;
    rdfs:comment "inverse of leavesRemainder: this item carries the outstanding scope of the target partial proposal. This is the direction a HUMAN writes, because `arrow-kanban update` resolves its subject through the item store and a proposal is not in it" ;
    rdfs:label "remainderOf" .

kb:ruledBy a owl:ObjectProperty ;
    rdfs:domain kb:Item ;
    rdfs:range kb:Item ;
    owl:inverseOf kb:scopes ;
    rdfs:label "ruledBy" ;
    rdfs:comment "this item's scope was set by the target ruling signal. Makes ruling provenance queryable instead of prose in a comment — the shape that let a proposal delete a public module citing a ruling that had no durable record. Only ONE direction is stored" .

kb:scopes a owl:ObjectProperty ;
    rdfs:domain kb:Item ;
    rdfs:range kb:Item ;
    owl:inverseOf kb:ruledBy ;
    rdfs:label "scopes" ;
    rdfs:comment "inverse of ruledBy: this ruling sets the scope of the target item" .

kb:implements a owl:ObjectProperty ;
    rdfs:domain kb:Expedition ;
    rdfs:range kb:Voyage ;
    owl:inverseOf kb:spawns ;
    rdfs:label "implements" ;
    rdfs:comment "an expedition delivers work toward a voyage" .

kb:spawns a owl:ObjectProperty ;
    rdfs:domain kb:Voyage ;
    rdfs:range kb:Expedition ;
    owl:inverseOf kb:implements ;
    rdfs:label "spawns" ;
    rdfs:comment "a voyage creates and coordinates an expedition" .

kb:tests a owl:ObjectProperty ;
    rdfs:domain kb:Hypothesis ;
    rdfs:range kb:Paper ;
    rdfs:label "tests" ;
    rdfs:comment "a hypothesis is tested in the context of a paper" .

kb:validates a owl:ObjectProperty ;
    rdfs:domain kb:Experiment ;
    rdfs:range kb:Hypothesis ;
    rdfs:label "validates" ;
    rdfs:comment "an experiment produces evidence for or against a hypothesis" .

# The ontology's canonical range is kb:Experiment, but `/hypothesize` links
# measures to the HYPOTHESIS. The comma-list below is read by the loader as a
# UNION (either target accepted) — deliberately mirroring live practice pending
# the follow-up ruling, exactly as the retired const did. (Strict OWL
# would intersect multiple rdfs:range triples; this file trades that formality
# for not silently invalidating existing edges.)
kb:measures a owl:ObjectProperty ;
    rdfs:domain kb:Measure ;
    rdfs:range kb:Experiment , kb:Hypothesis ;
    rdfs:label "measures" ;
    rdfs:comment "a measure tracks the outcome of an experiment (or, per current practice, a hypothesis)" .

# ─────────────────────────────────────────────────────────────────────────────
# LIFECYCLE STATES + TRANSITIONS (project-directed, 2026-08-13)
#
# The development board's states were a flat LIST (any state could follow any
# state) and the missing planning axis was simulated by tags the ready-frontier
# query had to subtract one by one. This section makes the lifecycle DATA, in
# the same file and under the same fail-closed loader discipline as the
# relationship vocabulary above.
#
# ⚠ DELIBERATELY NOT owl:Class / owl:ObjectProperty. Those two declaration
# shapes feed the EDGE-vocabulary parsers (predicates() / classes()): typing a
# state as owl:Class would admit it as a relate-target entity class, and typing
# kb:transitionsTo as owl:ObjectProperty would make it a `--relate` predicate.
# A lifecycle state is neither, so it gets its own typing and its own parser.
#
# THE ADOPTED STATE SET (the decision this section records):
#   backlog     raw intake — filed, not yet defined. Kept as-is: an idea's
#               landing place; distinct from being buildable.
#   planning    NEW (the mandated minimum): the item's contract is
#               being written/repaired. INVISIBLE to the executor frontier —
#               work cannot be claimed out of planning, which is the structural
#               fix for "an agent picks up a ticket and it is not fully
#               planned". A bounce's proper landing place; the consuming
#               deployment's "not yet released" tag is this state wearing a
#               tag (folding it is that deployment's follow-up).
#   ready       NEW: fully planned and claimable — what `backlog` used to
#               pretend to be. planning -> ready is the release/ratification
#               act. Adopted because without it the intake pile and the
#               claimable frontier stay conflated (the measured bounce cost:
#               six independent investigations of one void premise).
#   in_progress / review / done — unchanged.
#   approved    CONSIDERED AND NOT ADOPTED (recorded, not silent): approval is
#               already first-class on the PROPOSAL object (proposal approve). A
#               second approved state on the ITEM would store one fact in two
#               places — the drift class this repo exists to end.
#
# TRANSITION LEGALITY. Strict where nothing legitimate exists, permissive where
# live practice requires (a model that refuses the fleet's real moves on day
# one gets bypassed, which is worse than no model):
#   * planning -> in_progress is REFUSED — the one transition whose absence IS
#     the feature: unplanned work cannot be claimed.
#   * backlog -> in_progress stays LEGAL during migration — every pre-model
#     item claims that way today; refusing it would halt the fleet, and the
#     planning discipline arrives item-by-item as planners adopt the state.
#   * review -> {in_progress, backlog, planning} — rework, un-park,
#     and re-plan respectively. done -> {backlog, in_progress} — reopen paths
#     (measured live: a closed item reopened during a stop-cord clear).
#   * done is reachable from every non-terminal state: records close from
#     backlog (the RECORD-signal rule), abandons close from planning/ready
#     (wont_do/obsolete resolutions).

kb:backlog a kb:LifecycleState ;
    kb:board "development" ;
    rdfs:label "backlog" ;
    kb:transitionsTo kb:planning , kb:ready , kb:in_progress , kb:done , kb:stale ;
    rdfs:comment "raw intake — filed, not yet defined (backlog->in_progress stays legal for migration)" .

kb:planning a kb:LifecycleState ;
    kb:board "development" ;
    rdfs:label "planning" ;
    kb:transitionsTo kb:ready , kb:backlog , kb:done ;
    rdfs:comment "the contract is being written or repaired; NOT claimable — planning->in_progress is deliberately absent" .

kb:ready a kb:LifecycleState ;
    kb:board "development" ;
    rdfs:label "ready" ;
    kb:transitionsTo kb:in_progress , kb:planning , kb:done ;
    rdfs:comment "fully planned and claimable; planning->ready is the release act" .

kb:in_progress a kb:LifecycleState ;
    kb:board "development" ;
    rdfs:label "in_progress" ;
    kb:transitionsTo kb:review , kb:backlog , kb:planning , kb:done ;
    rdfs:comment "claimed and being built; ->backlog is the legacy bounce target, ->planning the re-plan-aware one" .

kb:review a kb:LifecycleState ;
    kb:board "development" ;
    rdfs:label "review" ;
    kb:transitionsTo kb:done , kb:in_progress , kb:backlog , kb:planning ;
    rdfs:comment "a proposal is under cross-agent review; ->backlog un-parks remaining scope" .

kb:done a kb:LifecycleState ;
    kb:board "development" ;
    rdfs:label "done" ;
    kb:transitionsTo kb:backlog , kb:in_progress ;
    rdfs:comment "terminal (with resolution); reopen paths kept — a close taken back is a real move, measured" .

kb:stale a kb:LifecycleState ;
    kb:board "development" ;
    rdfs:label "stale" ;
    kb:transitionsTo kb:backlog ;
    rdfs:comment "pre-backlog holding state for superseded-era work (a deliberate operator park; 132 live items rode in on it). Unpark goes to backlog; parking is legal from backlog only." .
